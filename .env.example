# Supabase Auth — valori pubblici disponibili nel pannello del progetto.
# Non inserire mai chiavi service_role o password nel repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origine dati della dashboard cliente.
# Mantieni fixtures finché migrazioni, bootstrap e RLS non sono applicati.
# Valori ammessi: fixtures | supabase
BETTERCALLQ_CLIENT_DATA_SOURCE=fixtures

# Salone predefinito della console amministrativa.
# Opzionale finché esiste un solo salone attivo.
BETTERCALLQ_ADMIN_DEFAULT_SALON_ID=

# Vapi — chiamata di prova nel browser (Impostazioni IA).
# La public key è pensata per il client: restringi i domini autorizzati
# dal pannello Vapi. Non inserire mai la chiave privata qui.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
